+package skyhaxe.assets;
+
+/** Generated from hash-pinned AS3 FontAsset Embed declarations. */
+class EmbeddedFontCatalog {
+    public static function metadataFor(className:String):{name:String, style:String} {
+        return switch (className) {
+            case "fonts._Str_10176": {name: "Ubuntu Medium", style: "regular"};
+            case "fonts._Str_10339": {name: "Volter Bold", style: "regular"};
+            case "fonts._Str_10363": {name: "Volter", style: "regular"};
+            case "fonts._Str_10537": {name: "UbuntuThick", style: "regular"};
+            case "fonts._Str_10581": {name: "Ubuntu", style: "boldItalic"};
+            case "fonts._Str_10940": {name: "Ubuntu", style: "regular"};
+            case "fonts._Str_11108": {name: "Ubuntu condensed", style: "regular"};
+            case "fonts._Str_11970": {name: "Ubuntu", style: "bold"};
+            case "fonts._Str_11991": {name: "Ubuntu", style: "italic"};
+            case "onBoardingHcUi._Str_1000": {name: "Ubuntu Italic", style: "regular"};
+            case "onBoardingHcUi._Str_666": {name: "Ubuntu Bold Italic", style: "regular"};
+            case "onBoardingHcUi._Str_771": {name: "Ubuntu", style: "regular"};
+            case "onBoardingHcUi._Str_955": {name: "Ubuntu bold", style: "regular"};
+            default: throw new haxe.Exception('Unregistered embedded font class: ' + className);
+        };
+    }
+}
