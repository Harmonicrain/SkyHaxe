package skyhaxe.assets;

import openfl.utils.Assets;

/** HTML5 equivalent of the anonymous classes generated by Flex for component-library embeds. */
class ComponentLibraryEmbedFactory {
    public static function create(id:String, kind:String):Class<Dynamic> {
        var constructor:Dynamic;
        if (kind == "bitmap") {
            constructor = function() {
                // Opt-in: a boot instantiates thousands of these, and logging every one fills the
                // console ring buffer so nothing else can be read back from it.
                #if (js && skyhaxe_embed_trace)
                js.Browser.console.info("SKYHAXE_COMPONENT_EMBED_INSTANTIATE " + id);
                #end
                var source = Assets.getBitmapData(id);
                if (source == null) throw new haxe.Exception("Embedded bitmap was not preloaded: " + id);
                return new mx.core.BitmapAsset(source.clone());
            };
        } else if (StringTools.endsWith(id, ".mp3")) {
            // Flex embedded an MP3 as a class extending Sound, and `SoundAsset` still relies on
            // that: it instantiates the embed class and casts the result to Sound. A ByteArrayAsset
            // fails that cast silently, leaving the asset's content null -- and the converted
            // `HabboSoundManagerFlash10.playSound` assigns `volume` on it with no null check,
            // exactly as the AS3 does. Every message send, respect, purchase and camera shutter
            // threw; inside a Core update receiver that throw is fatal and blacks out the client.
            //
            // The embed manifest records these as `kind: "bytes"` because that is how they are
            // stored, so the sound case is recognised by extension rather than by kind.
            constructor = function() {
                #if (js && skyhaxe_embed_trace)
                js.Browser.console.info("SKYHAXE_COMPONENT_EMBED_INSTANTIATE " + id);
                #end
                var source = Assets.getBytes(id);
                if (source == null) throw new haxe.Exception("Embedded sound was not preloaded: " + id);
                var sound = new openfl.media.Sound();
                // Reaches AudioBuffer.fromBytes, which on HTML5 wraps the frames in a Howler
                // source and sniffs the codec from the header, so the DefineSound rate/channel
                // fields are not needed and are deliberately not second-guessed here.
                sound.loadCompressedDataFromByteArray(
                    openfl.utils.ByteArray.fromBytes(source), source.length);
                return sound;
            };
        } else {
            constructor = function() {
                // Opt-in: a boot instantiates thousands of these, and logging every one fills the
                // console ring buffer so nothing else can be read back from it.
                #if (js && skyhaxe_embed_trace)
                js.Browser.console.info("SKYHAXE_COMPONENT_EMBED_INSTANTIATE " + id);
                #end
                var source = Assets.getBytes(id);
                if (source == null) throw new haxe.Exception("Embedded bytes were not preloaded: " + id);
                var result = new mx.core.ByteArrayAsset();
                result.writeBytes(openfl.utils.ByteArray.fromBytes(source));
                result.position = 0;
                return result;
            };
        }
        // Haxe's JavaScript `Class` test recognizes constructors by this marker.
        // Flex emitted a real anonymous class for every [Embed]; preserve that
        // observable contract so generated callers can use Type.createInstance.
        Reflect.setField(constructor, "__name__", "skyhaxe.embed." + id);
        return cast constructor;
    }
}
